   <string notr="true">QMainWindow {
background-color: #121212;
}

QWidget {
background-color: #121212;
color: #FFFFFF;
}

QPushButton {
background-color: white;
color: #FFFFFF;
border-radius: 20px;
padding: 10px;
border: none;
padding-right: 5px;
}

QSlider::groove:horizontal {
background: white;
height: 4px;
border-radius: 2px;
}

QSlider::sub-page:horizontal {
height: 4px;
border-radius: 2px;
}

QListWidget {
background-color: #212121;
color: #FFFFFF;
border: none;
}

QLabel {
color: #FFFFFF;
}

QTextEdit {
border: none;
}

QPushButton#PlayBtn {
background-color: none;
}

QPushButton#NextBtn {
background-color: none;
}

QPushButton#PrevBtn {
background-color: none;
}

QPushButton#VolBtn {
background-color: none;
}

QPushButton#LikeBtn {
background-color: none;
}

QPushButton#downloadBtn {
background-color: none;
}

QPushButton#HomeBtn {
text-align: left;
padding-left: 16px;
icon-size: 24px 24px;
background-color: none;
color: #FF4B5C;
}

QPushButton#closeBtn{
    border-radius: 0px;
    background-color: transparent;
    padding: 0px;
    icon-size: 16px 16px;
}

QPushButton#minimizeBtn{
    border-radius: 0px;
    background-color: transparent;
    padding: 0px;
    icon-size: 16px 16px;
}

QPushButton#maximizeBtn{
    border-radius: 0px;
    background-color: transparent;
    padding: 0px; 
    icon-size: 16px 16px;
}

QPushButton#closeBtn:hover{
	background-color: #E81123;
}

QPushButton#minimizeBtn:hover{
	background-color: #3D3D3D;
}

QPushButton#maximizeBtn:hover{
	background-color: #3D3D3D;
}

QPushButton#FavoriteBtn {
text-align: left;
background-color: none;
color: #FF4B5C;
}

QPushButton#TeamNameBtn {
	text-align: left;
	padding-left: 16px;
	background-color: none;
	color: white;
	font-size: 30px;
}

QPushButton#TeamName1Btn {
text-align: left;
padding-left: 16px;
background-color: none;
color: #FF4B5C;
font-size: 30px;
}


QPushButton#LibraryBtn {
text-align: left;
padding-left: 16px;
icon-size: 24px 24px;
background-color: none;
color: #FF4B5C;
}

QPushButton#AddBtn {
text-align: left;
padding-left: 16px;
icon-size: 24px 24px;
background-color: none;
color: #FF4B5C;
}

QPushButton#SearchBtn {
text-align: left;
padding-left: 16px;
icon-size: 24px 24px;
background-color: none;
color: #FF4B5C;
}

QPushButton#musicbtn{
	background-color:none;
}

QVBoxLayout {
color: grey;
}

QWidget#playpanel {
border-top: 2px solid #FF4B5C;
color: green;
padding-bottom: 20px;
}

QPushButton#HunterBtn {
background-color: none;
color: #FF4B5C;
}

QPushButton#Bugbtn {
