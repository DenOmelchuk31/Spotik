   <string notr="true">QMainWindow {
    background-color:  #121212;
}

QWidget {
    background-color: #121212;
    color: #FFFFFF;
}

QPushButton {
    background-color: white;
    color: #FFFFFF;
    border-radius: 20px;
    padding: 10px;
    border: none;
	padding-right: 5px;
}

QSlider::groove:horizontal {
    background: white;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    height: 4px;
    border-radius: 2px;
}

QListWidget {
    background-color: #212121;
    color: #FFFFFF;
    border: none;
}

QLabel {
    color: #FFFFFF;
}

QTextEdit {
	border: none;
}

QPushButton#PlayBtn {
	background-color: none;
}

QPushButton#NextBtn {
	background-color: none;
}

QPushButton#PrevBtn {
	background-color: none;
}

QPushButton#VolBtn {
	background-color: none;
}

QPushButton#LikeBtn {
	background-color: none;
}

QPushButton#downloadBtn {
	background-color: none;
}

QPushButton#HomeBtn {
    text-align: left;
    padding-left: 16px;
    icon-size: 24px 24px;
	background-color: none;
	color: #FF4B5C;
}

QPushButton#LibraryBtn {
    text-align: left;
    padding-left: 16px;
    icon-size: 24px 24px;
	background-color: none;
	color: #FF4B5C;
}

QPushButton#AddBtn {
    text-align: left;
