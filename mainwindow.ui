    icon-size: 24px 24px;
	background-color: none;
	color: #FF4B5C;
}

QPushButton#SearchBtn {
    text-align: left;
    padding-left: 16px;
    icon-size: 24px 24px;
	background-color: none;
	color: #FF4B5C;
}

QVBoxLayout {
	color:  grey;
}

QWidget#playpanel {
	border: 2px solid #FF4B5C;
	color: black;	
}

QWidget#leftwidget {
	border: 2px solid #FF4B5C;
	color: black;	
}

QPushButton#HunterBtn {
	background-color: none;
	color: #FF4B5C;
}

QPushButton#Bugbtn {
	background-color: none;
}

QWidget#namewidget {
	border: 2px solid #FF4B5C;
	color: black;	
}</string>
