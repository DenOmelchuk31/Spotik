}

QSlider::handle:horizontal {
background-color: #FF4B5C;
border-radius: 6px;
width: 12px;
height: 12px;
margin: -5px 0;
}

QSlider::groove:horizontal {
background-color: #555555;
height: 2px;
border-radius: 1px;
}

QSlider::sub-page:horizontal {
background-color: #FF4B5C;
height: 2px;
border-radius: 1px;
}

QWidget#HomeWidget {
background-color: #FF4B5C;
}</string>
